NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database Configuration (DBaaS RDS or Local MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=mediconnect_db
DATABASE_USER=root
DATABASE_PASSWORD=your_secure_password
AWS_USE_LOCAL_AUTH=true

# AWS Configuration (Storage as a Service & Identity)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_DOCUMENTS_BUCKET=mediconnect-cloud-documents-prod

# Amazon Cognito Configuration
COGNITO_USER_POOL_ID=ap-south-1_XXXXX
COGNITO_CLIENT_ID=abcdef1234567890abcdef
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_XXXXX

# Security Toggle (Local Auth ONLY for development testing)
AWS_USE_LOCAL_AUTH=true
UPLOAD_MAX_BYTES=10485760