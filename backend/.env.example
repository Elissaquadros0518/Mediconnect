# Azure Blob Storage settings. The VM's managed identity supplies credentials.
AZURE_STORAGE_ACCOUNT_URL=https://mediconnectstorage01.blob.core.windows.net
AZURE_STORAGE_CONTAINER=medical-docs
AZURE_BLOB_UPLOAD_SAS_TTL_SECONDS=300
AZURE_BLOB_DOWNLOAD_SAS_TTL_SECONDS=120

# Supabase anon/publishable key is required for document lookups under caller RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
